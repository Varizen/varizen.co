# Copy to .env (git-ignored) or inject via your secret manager.
# NEVER commit real values. NEVER ship these to the browser.

OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=

# Comma-separated install tokens the gateway will accept from browsers.
EYE_INSTALL_TOKENS=

# Kill switch
EYE_AI_ENABLED=true

# Requests per minute per install token
EYE_RATE_LIMIT=30

# Optional: restrict to an explicit free-model allowlist (comma separated ids)
EYE_FREE_MODEL_ALLOWLIST=

PORT=8787
