# Public canonical URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://varizen.co
# PostgreSQL 16+; required for contact storage, health checks and authenticated sessions
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/varizen
DATABASE_SSL=true
# Generate independently: openssl rand -base64 48
RATE_LIMIT_PEPPER=replace-with-a-long-random-secret
# Trust only the documented deployment proxy's sanitized forwarding header
TRUST_PROXY_HEADERS=false

# --- Eye AI gateway (AiBrowser desktop app) ---
# Provider keys live ONLY here. Never ship them to the browser or the client bundle.
# Chat returns 503 until both a key and at least one install token are set.
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
# Comma-separated install tokens handed to AiBrowser users. Unset => chat fails closed.
EYE_INSTALL_TOKENS=
# Kill switch. Set to false to disable Eye AI without removing keys.
EYE_AI_ENABLED=true

# --- AiBrowser download ---
# The release zip is a build artifact and is git-ignored, so it is absent on a fresh
# clone. Point this at a hosted release; the download route 307-redirects to it.
AIBROWSER_RELEASE_URL=

# No analytics credentials are shipped. Optional analytics are disabled by default.
