# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/sbom.json

# next.js
/.next/
/out/

# production
/build

# browser release artifacts — built locally, never committed (81MB+)
/public/downloads/*.zip
/public/downloads/*.exe
/browser/dist/
/browser/*.zip
*.zip

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the documented template must ship, or deployers have nothing to copy.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
